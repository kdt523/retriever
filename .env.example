# Copy to .env (git-ignored). All settings use the RR_ prefix; see src/runbook_retriever/config.py.

# Google AI Studio key, needed from Phase 2 (query generation).
RR_GEMINI_API_KEY=

# live = call the API on cache miss; cache_only = never touch the network.
RR_LLM_MODE=live
# Stay under the free-tier requests-per-minute limit.
RR_LLM_RPM=8
# Hard cap on API calls per process run.
RR_LLM_MAX_CALLS=200

RR_SEED=42
